# Copy to .env and edit. Every value has a working default except the SEC
# user agent, which the SEC requires to carry real contact information.

# --- required by SEC terms of use -------------------------------------------
# Requests without a descriptive UA and contact email risk an IP block.
SF_SEC_USER_AGENT="SignalForge/0.1 (research; you@example.com)"

# --- providers --------------------------------------------------------------
SF_DEFAULT_PROVIDER=ollama
SF_OLLAMA_HOST=http://localhost:11434
SF_EMBED_MODEL=nomic-embed-text

# Optional. Setting this is the only step needed to route tasks to Claude;
# switch a pipeline's chain to `extract_hosted` or `judge` in configs/models.yaml.
# SF_ANTHROPIC_API_KEY=sk-ant-...

# --- reliability and cost ---------------------------------------------------
# Hard ceiling per run. Exceeding it raises rather than spending quietly.
SF_RUN_COST_CAP_USD=5.0
SF_MAX_RETRIES=3
SF_CACHE_ENABLED=true

# --- paths ------------------------------------------------------------------
# SF_DATA_DIR=./data
# SF_DB_PATH=./data/signalforge.duckdb

SF_LOG_LEVEL=INFO
SF_TRACE_ENABLED=true
